# --- Python 自动生成文件 ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- 虚拟环境 ---
.venv/
env/
venv/
ENV/

# --- 敏感信息 (非常重要！) ---
.env
# 注意：.env.example 应该保留在仓库中作为模板，不需要忽略

# --- 编辑器配置 ---
.vscode/
.idea/
*.swp

# --- 本地运行数据 ---
storage/sessions.json
storage/users.json
logs/runs.jsonl
# 如果 storage 目录下全是运行时产生的临时数据，也可以直接忽略整个文件夹：
# storage/

# --- 其他 ---
.DS_Store

data/

# --- 交付物的可再生产物 ---
# deliverables/build/ 下的内容都能由 build/ 目录里的脚本重新生成，
# 把中间产物提交进仓库只会造成「文档与生成脚本不一致」的漂移。
deliverables/build/slides/
deliverables/build/docx/
deliverables/build/merged/
# 02_源代码是源码快照，可由 copy_source.py 重新生成；
# 直接把源码副本提交进仓库会与根目录的实际代码产生双份真相。
deliverables/02_源代码/