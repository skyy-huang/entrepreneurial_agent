# 复制本文件为 .env 并填写实际值。.env 已被 .gitignore 忽略，切勿提交。

# ── 大模型配置 ────────────────────────────────────────────────
# DeepSeek 兼容 OpenAI 协议。不配置时 F1/F3 仍可完整运行（本地确定性引擎），
# F2 项目指导会降级为规则引擎模式，并在日志与响应中如实标注 degraded。
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 可选：覆盖默认模型名，会记录进运行日志的 model 字段
# MODEL_NAME=deepseek-chat

# ── F1 理论学习增强（可选）────────────────────────────────────
# 设为 1 时，本地知识库未收录的概念会额外调用大模型补充一段解释，
# 该段会被明确标注为「未经核验」。默认 0（纯本地，不会产生编造引用）。
ENABLE_LLM_F1=0

# ── 教师 / 管理员账号 ─────────────────────────────────────────
# 凭据只从环境变量读取，不写进代码。未配置时系统会生成一次性随机口令，
# 并在启动日志中以 WARNING 级别打印一次。
# 格式为 JSON：{"账号":"口令","账号2":"口令2"}
TEACHER_ACCOUNTS={"teacher1":"请改成你自己的口令"}
ADMIN_ACCOUNTS={"admin":"请改成你自己的管理员口令"}
